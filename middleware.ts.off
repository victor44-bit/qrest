// middleware.ts
import { NextResponse } from "next/server";
import type { NextRequest } from "next/server";

export function middleware(req: NextRequest) {
  const { pathname, origin } = req.nextUrl;

  // ✅ Skip uploads route completely (important for file handling)
  if (pathname.startsWith("/api/uploads")) {
    return NextResponse.next();
  }

  // ✅ Protect /admin routes
  if (pathname.startsWith("/admin")) {
    const isAdmin = req.cookies.get("qrest_admin")?.value === "1";
    if (!isAdmin && !pathname.startsWith("/admin/login")) {
      const url = new URL("/admin/login", origin);
      return NextResponse.redirect(url);
    }
  }

  return NextResponse.next();
}

// ✅ Make sure middleware ignores Next.js internal assets (fixes CSS/JS 404)
export const config = {
  matcher: [
    "/((?!_next/static|_next/image|favicon.ico|robots.txt|sitemap.xml|api/uploads).*)",
  ],
};
